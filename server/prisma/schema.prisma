generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AssetStatus {
  AVAILABLE
  RESERVED
  PENDING_CONFIRMATION
  ASSIGNED
  IN_USE
  UNDER_MAINTENANCE
  LOST
  DISPOSED
}

enum LocationType {
  STORE
  WAREHOUSE
  RACK
  LEVEL
  BIN
  FILE
  PRODUCTION_AREA
  MACHINE_LOCATION
  OTHER
}

enum AssetCondition {
  NEW
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum EpcStatus {
  ACTIVE
  INACTIVE
  DAMAGED
  LOST
  RETIRED
}

enum AssignmentStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

enum MovementType {
  LOCATION_TRANSFER
  DEPARTMENT_TRANSFER
  FULL_TRANSFER
}

enum IssueBatchStatus {
  PREPARING
  PROCESSING
  COMPLETED
  CANCELLED
}

enum IssueBatchItemStatus {
  RESERVED
  ISSUED
  CONFIRMED
  RETURNED
  CANCELLED
}

enum ConfirmationType {
  ISSUE_CONFIRMATION
  RETURN_CONFIRMATION
}

enum ConfirmationSource {
  WEB_ADMIN
  HANDHELD
}

enum HandheldSwapTaskStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Location {
  id                  Int               @id @default(autoincrement())
  locationCode        String            @unique @map("location_code")
  name                String
  description         String?
  parentLocationId    Int?              @map("parent_location_id")
  departmentId        Int?              @map("department_id")
  locationType        LocationType      @default(OTHER) @map("location_type")
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  parentLocation      Location?         @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations      Location[]        @relation("LocationHierarchy")
  department          Department?       @relation(fields: [departmentId], references: [id])
  assets              Asset[]
  homeAssets          Asset[]           @relation("AssetHomeLocation")
  defaultIssueBatches IssueBatch[]      @relation("IssueBatchDefaultLocation")
  issueBatchItems     IssueBatchItem[]  @relation("IssueBatchItemLocation")
  assetAssignments    AssetAssignment[] @relation("AssignmentLocation")
  returnAssignments   AssetAssignment[] @relation("AssignmentReturnLocation")
  fromAssetMovements  AssetMovement[]   @relation("AssetMovementFromLocation")
  toAssetMovements    AssetMovement[]   @relation("AssetMovementToLocation")

  @@index([parentLocationId])
  @@index([departmentId])
  @@map("locations")
}

model Department {
  id                 Int               @id @default(autoincrement())
  departmentCode     String            @unique @map("department_code")
  name               String
  description        String?
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  users              User[]
  locations          Location[]
  assetAssignments   AssetAssignment[]
  fromAssetMovements AssetMovement[]   @relation("AssetMovementFromDepartment")
  toAssetMovements   AssetMovement[]   @relation("AssetMovementToDepartment")

  @@map("departments")
}

model AssetCategory {
  id           Int        @id @default(autoincrement())
  categoryCode String     @unique @map("category_code")
  name         String
  description  String?
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  assets       Asset[]
  @@map("asset_categories")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  fullName     String   @map("full_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       Int      @map("role_id")
  departmentId Int?     @map("department_id")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role                Role                    @relation(fields: [roleId], references: [id])
  department          Department?             @relation(fields: [departmentId], references: [id])
  assignedAsset       AssetAssignment[]       @relation("AssignedToUser")
  createdAssignments  AssetAssignment[]       @relation("AssignedByUser")
  movedAssetMovements AssetMovement[]         @relation("AssetMovementMovedBy")
  createdIssueBatches IssueBatch[]            @relation("IssueBatchCreatedBy")
  defaultIssueBatches IssueBatch[]            @relation("IssueBatchDefaultRecipient")
  selectedBatchItems  IssueBatchItem[]        @relation("IssueBatchItemSelectedBy")
  recipientBatchItems IssueBatchItem[]        @relation("IssueBatchItemRecipient")
  returnedAssignments AssetAssignment[]       @relation("AssignmentReturnedBy")
  scanConfirmations   AssetScanConfirmation[] @relation("ConfirmationConfirmedBy")
  createdHandheldSwapTasks HandheldSwapTask[] @relation("HandheldSwapCreatedBy")
  confirmedHandheldSwapTasks HandheldSwapTask[] @relation("HandheldSwapConfirmedBy")
  cancelledHandheldSwapTasks HandheldSwapTask[] @relation("HandheldSwapCancelledBy")

  @@map("users")
}

model IssueBatch {
  id                     Int              @id @default(autoincrement())
  batchNo                String           @unique @map("batch_no")
  jobNo                  String?          @map("job_no")
  defaultRecipientUserId Int?             @map("default_recipient_user_id")
  defaultToLocationId    Int?             @map("default_to_location_id")
  status                 IssueBatchStatus @default(PREPARING)
  remarks                String?
  createdByUserId        Int              @map("created_by_user_id")
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  defaultRecipient  User?            @relation("IssueBatchDefaultRecipient", fields: [defaultRecipientUserId], references: [id], onDelete: Restrict)
  defaultToLocation Location?        @relation("IssueBatchDefaultLocation", fields: [defaultToLocationId], references: [id], onDelete: Restrict)
  createdBy         User             @relation("IssueBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items             IssueBatchItem[]
  handheldSwapTasks HandheldSwapTask[]

  @@index([jobNo])
  @@index([status])
  @@index([createdByUserId])
  @@index([defaultRecipientUserId])
  @@index([defaultToLocationId])
  @@map("issue_batches")
}

model IssueBatchItem {
  id                   Int                  @id @default(autoincrement())
  issueBatchId         Int                  @map("issue_batch_id")
  assetId              Int                  @map("asset_id")
  status               IssueBatchItemStatus @default(RESERVED)
  recipientUserId      Int?                 @map("recipient_user_id")
  toLocationId         Int?                 @map("to_location_id")
  selectedByUserId     Int                  @map("selected_by_user_id")
  selectedAt           DateTime             @default(now()) @map("selected_at")
  cancelledAt          DateTime?            @map("cancelled_at")
  replacementForItemId Int?                 @unique @map("replacement_for_item_id")
  remarks              String?
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  issueBatch        IssueBatch              @relation(fields: [issueBatchId], references: [id], onDelete: Restrict)
  asset             Asset                   @relation(fields: [assetId], references: [id])
  recipient         User?                   @relation("IssueBatchItemRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  toLocation        Location?               @relation("IssueBatchItemLocation", fields: [toLocationId], references: [id], onDelete: Restrict)
  selectedBy        User                    @relation("IssueBatchItemSelectedBy", fields: [selectedByUserId], references: [id], onDelete: Restrict)
  replacementForItem IssueBatchItem?        @relation("IssueBatchItemReplacement", fields: [replacementForItemId], references: [id], onDelete: Restrict)
  replacementItem    IssueBatchItem?        @relation("IssueBatchItemReplacement")
  assignment        AssetAssignment?
  scanConfirmations AssetScanConfirmation[]
  movements         AssetMovement[]
  handheldSwapTasks HandheldSwapTask[]

  @@index([issueBatchId, status])
  @@index([assetId, status])
  @@index([recipientUserId])
  @@index([toLocationId])
  @@index([selectedByUserId])
  @@map("issue_batch_items")
}

model Asset {
  id                Int            @id @default(autoincrement())
  assetCode         String         @unique @map("asset_code")
  itemName          String         @map("item_name")
  categoryId        Int            @map("category_id")
  locationId        Int?           @map("location_id")
  homeLocationId    Int?           @map("home_location_id")
  homeLocation      Location?      @relation("AssetHomeLocation", fields: [homeLocationId], references: [id], onDelete: Restrict)
  serialNumber      String?        @unique @map("serial_number")
  brand             String?
  model             String?
  measurementHeight Decimal?       @map("measurement_height") @db.Decimal(10, 2)
  measurementWidth  Decimal?       @map("measurement_width") @db.Decimal(10, 2)
  gridUp            Int?           @map("grid_up")
  radius            Decimal?       @db.Decimal(10, 2)
  gapMm             Decimal?       @map("gap_mm") @db.Decimal(10, 2)
  purchaseDate      DateTime?      @map("purchase_date") @db.Date
  purchaseCost      Decimal?       @map("purchase_cost") @db.Decimal(12, 2)
  status            AssetStatus    @default(AVAILABLE)
  condition         AssetCondition @default(GOOD)
  remarks           String?
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  category          AssetCategory           @relation(fields: [categoryId], references: [id])
  location          Location?               @relation(fields: [locationId], references: [id])
  epc               AssetEpc?
  assignments       AssetAssignment[]
  movements         AssetMovement[]
  issueBatchItems   IssueBatchItem[]
  scanConfirmations AssetScanConfirmation[]
  handheldReplacementTasks HandheldSwapTask[]

  @@index([categoryId])
  @@index([locationId])
  @@index([homeLocationId])
  @@map("assets")
}

model HandheldSwapTask {
  id                 Int                      @id @default(autoincrement())
  issueBatchId       Int                      @map("issue_batch_id")
  targetItemId       Int                      @map("target_item_id")
  replacementAssetId Int                      @map("replacement_asset_id")
  status             HandheldSwapTaskStatus   @default(PENDING)
  remarks            String?
  createdByUserId    Int                      @map("created_by_user_id")
  confirmedByUserId  Int?                     @map("confirmed_by_user_id")
  confirmedAt        DateTime?                @map("confirmed_at")
  cancelledByUserId  Int?                     @map("cancelled_by_user_id")
  cancelledAt        DateTime?                @map("cancelled_at")
  cancellationReason String?                  @map("cancellation_reason")
  oldVerifiedEpc     String?                  @map("old_verified_epc")
  oldVerifiedAt      DateTime?                @map("old_verified_at")
  oldVerifiedSource  ConfirmationSource?      @map("old_verified_source")
  newVerifiedEpc     String?                  @map("new_verified_epc")
  newVerifiedAt      DateTime?                @map("new_verified_at")
  newVerifiedSource  ConfirmationSource?      @map("new_verified_source")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  issueBatch       IssueBatch     @relation(fields: [issueBatchId], references: [id], onDelete: Restrict)
  targetItem       IssueBatchItem @relation(fields: [targetItemId], references: [id], onDelete: Restrict)
  replacementAsset Asset          @relation(fields: [replacementAssetId], references: [id], onDelete: Restrict)
  createdBy        User           @relation("HandheldSwapCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedBy      User?          @relation("HandheldSwapConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: Restrict)
  cancelledBy      User?          @relation("HandheldSwapCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([issueBatchId, status])
  @@index([targetItemId, status])
  @@index([replacementAssetId, status])
  @@index([cancelledByUserId])
  @@map("handheld_swap_tasks")
}

model AssetEpc {
  id           Int       @id @default(autoincrement())
  epcCode      String    @unique @map("epc_code")
  assetId      Int       @unique @map("asset_id")
  status       EpcStatus @default(ACTIVE)
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")
  remarks      String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("asset_epcs")
}

model AssetAssignment {
  id               Int              @id @default(autoincrement())
  assignmentNo     String           @unique @map("assignment_no")
  assetId          Int              @map("asset_id")
  assignedToUserId Int              @map("assigned_to_user_id")
  assignedByUserId Int              @map("assigned_by_user_id")
  departmentId     Int?             @map("department_id")
  locationId       Int?             @map("location_id")
  issueBatchItemId Int?             @unique @map("issue_batch_item_id")
  assignedDate     DateTime         @map("assigned_date") @db.Date
  issuedAt         DateTime?        @map("issued_at")
  returnDueDate    DateTime?        @map("return_due_date") @db.Date
  returnedAt       DateTime?        @map("returned_at")
  returnCondition  AssetCondition?  @map("return_condition")
  returnLocationId Int?             @map("return_location_id")
  returnRemarks    String?          @map("return_remarks")
  returnedByUserId Int?             @map("returned_by_user_id")
  status           AssignmentStatus @default(ACTIVE)
  purpose          String?
  remarks          String?
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  asset             Asset                   @relation(fields: [assetId], references: [id])
  assignedToUser    User                    @relation("AssignedToUser", fields: [assignedToUserId], references: [id])
  assignedByUser    User                    @relation("AssignedByUser", fields: [assignedByUserId], references: [id])
  department        Department?             @relation(fields: [departmentId], references: [id])
  location          Location?               @relation("AssignmentLocation", fields: [locationId], references: [id])
  returnLocation    Location?               @relation("AssignmentReturnLocation", fields: [returnLocationId], references: [id])
  returnedByUser    User?                   @relation("AssignmentReturnedBy", fields: [returnedByUserId], references: [id])
  issueBatchItem    IssueBatchItem?         @relation(fields: [issueBatchItemId], references: [id])
  scanConfirmations AssetScanConfirmation[]

  @@index([assetId])
  @@index([assignedToUserId])
  @@index([assignedByUserId])
  @@index([departmentId])
  @@index([locationId])
  @@index([returnLocationId])
  @@index([returnedByUserId])
  @@map("asset_assignments")
}

model AssetScanConfirmation {
  id                 Int                @id @default(autoincrement())
  assetId            Int                @map("asset_id")
  issueBatchItemId   Int                @map("issue_batch_item_id")
  assignmentId       Int?               @map("assignment_id")
  confirmationType   ConfirmationType   @map("confirmation_type")
  confirmationSource ConfirmationSource @map("confirmation_source")
  epc                String
  confirmedByUserId  Int                @map("confirmed_by_user_id")
  confirmedAt        DateTime           @default(now()) @map("confirmed_at")
  remarks            String?

  asset          Asset            @relation(fields: [assetId], references: [id])
  issueBatchItem IssueBatchItem   @relation(fields: [issueBatchItemId], references: [id])
  assignment     AssetAssignment? @relation(fields: [assignmentId], references: [id])
  confirmedBy    User             @relation("ConfirmationConfirmedBy", fields: [confirmedByUserId], references: [id])

  @@index([assetId])
  @@index([issueBatchItemId])
  @@index([assignmentId])
  @@index([confirmedByUserId])
  @@index([confirmedAt])
  @@map("asset_scan_confirmations")
}

model AssetMovement {
  id               Int          @id @default(autoincrement())
  movementNo       String       @unique @map("movement_no")
  assetId          Int          @map("asset_id")
  issueBatchItemId Int?         @map("issue_batch_item_id")
  fromDepartmentId Int?         @map("from_department_id")
  toDepartmentId   Int?         @map("to_department_id")
  fromLocationId   Int?         @map("from_location_id")
  toLocationId     Int?         @map("to_location_id")
  movedByUserId    Int          @map("moved_by_user_id")
  movementType     MovementType @map("movement_type")
  movementDate     DateTime     @default(now()) @map("movement_date")
  reason           String?
  remarks          String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  asset          Asset           @relation(fields: [assetId], references: [id])
  issueBatchItem IssueBatchItem? @relation(fields: [issueBatchItemId], references: [id], onDelete: SetNull)
  movedByUser    User            @relation("AssetMovementMovedBy", fields: [movedByUserId], references: [id])
  fromDepartment Department?     @relation("AssetMovementFromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment   Department?     @relation("AssetMovementToDepartment", fields: [toDepartmentId], references: [id])
  fromLocation   Location?       @relation("AssetMovementFromLocation", fields: [fromLocationId], references: [id])
  toLocation     Location?       @relation("AssetMovementToLocation", fields: [toLocationId], references: [id])

  @@index([assetId])
  @@index([issueBatchItemId])
  @@index([movedByUserId])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@map("asset_movements")
}
